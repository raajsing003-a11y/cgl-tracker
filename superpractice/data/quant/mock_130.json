\" style=\"border:1px solid black;padding:5px;\">6</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">240</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">26</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">5</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">130</td></tr></table><p>Mean = &#931; x. f/&#931;f</p><p>= 577/17 = 33.9</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>Find the mode (correct up to two decimal places) of the given data:</p><table style=\"border-collapse:collapse;\"><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">Class interval</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">Frequency</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">1  -  10</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">28</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">11  -  20</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">30</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">21  -  30</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">10</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">31  -  40</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">20</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">41  -  50</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">22</td></tr></table>", "q_hi": "<p>&#2342;&#2367;&#2319; &#2327;&#2319; &#2337;&#2375;&#2335;&#2366; &#2325;&#2366; &#2348;&#2361;&#2369;&#2354;&#2325; (&#2342;&#2379; &#2342;&#2358;&#2350;&#2354;&#2357; &#2360;&#2381;&#2341;&#2366;&#2344;&#2379;&#2306; &#2340;&#2325; &#2360;&#2361;&#2368;) &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2352;&#2375;&#2306;:</p><table style=\"border-collapse:collapse;\"><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">&#2357;&#2352;&#2381;&#2327; &#2309;&#2306;&#2340;&#2352;&#2366;&#2354;</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">&#2310;&#2357;&#2371;&#2340;&#2381;&#2340;&#2367;</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">1 - 10</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">28</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">11 - 20</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">30</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">21 - 30</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">10</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">31 - 40</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">20</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">41 - 50</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">22</td></tr></table>", "options_en": ["12.06", "11.81", "12.12", "13.23"], "options_hi": ["12.06", "11.81", "12.12", "13.23"], "answer": 1, "solution_en": "<p>Modal class = 11  -  20 [the frequency of this class is highest]</p><p>Now,</p><p><img width=185 height=45 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image001.png\"></p><p><img width=197 height=21 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image002.png\"></p><p><img width=195 height=24 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image003.png\"></p><p><img width=373 height=24 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image004.png\"></p><p><img width=357 height=24 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image005.png\"></p><p><img width=159 height=41 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image006.png\"></p><p><img width=64 height=41 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image007.png\"></p><p><img width=71 height=19 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image008.png\"></p><p><img width=51 height=19 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image009.png\"></p>", "solution_hi": "<p>Modal class = 11  -  20 [the frequency of this class is highest]</p><p>Now,</p><p><img width=185 height=45 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image001.png\"></p><p><img width=197 height=21 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image002.png\"></p><p><img width=195 height=24 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image003.png\"></p><p><img width=373 height=24 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image004.png\"></p><p><img width=357 height=24 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image005.png\"></p><p><img width=159 height=41 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image006.png\"></p><p><img width=64 height=41 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image007.png\"></p><p><img width=71 height=19 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image008.png\"></p><p><img width=51 height=19 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p27108/image009.png\"></p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>Find the median of the following data:</p><p>24, 58, 39, 50, 32, 7, 10, 36, 25, 42, 21, 18</p>", "q_hi": "<p>&#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2310;&#2305;&#2325;&#2337;&#2364;&#2379;&#2306; &#2325;&#2366; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;:</p><p>24, 58, 39, 50, 32, 7, 10, 36, 25, 42, 21, 18</p>", "options_en": ["27", "27.5", "28", "28.5"], "options_hi": ["27", "27.5", "28", "28.5"], "answer": 3, "solution_en": "<p>Data: 24, 58, 39, 50, 32, 7, 10, 36, 25, 42, 21, 18</p><p>Data in ascending order: 7, 10, 18, 21, 24, 25, 32, 36, 39, 42, 50, 58</p><p>Median = [(12/2) + (12/2 + 1)]th terms/2 = (25 + 32)/2 = 28.5</p>", "solution_hi": "<p>Data: 24, 58, 39, 50, 32, 7, 10, 36, 25, 42, 21, 18</p><p>Data in ascending order: 7, 10, 18, 21, 24, 25, 32, 36, 39, 42, 50, 58</p><p>Median = [(12/2) + (12/2 + 1)]th terms/2 = (25 + 32)/2 = 28.5</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>The mean of 13 observations is 50 and the median of the observations is 47. Find the mode of the observations.</p>", "q_hi": "<p>13 &#2346;&#2381;&#2352;&#2375;&#2325;&#2381;&#2359;&#2339;&#2379;&#2306; &#2325;&#2366; &#2350;&#2366;&#2343;&#2381;&#2351; 50 &#2361;&#2376; &#2324;&#2352; &#2346;&#2381;&#2352;&#2375;&#2325;&#2381;&#2359;&#2339;&#2379;&#2306; &#2325;&#2368; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; 47 &#2361;&#2376;&#2404; &#2346;&#2381;&#2352;&#2375;&#2325;&#2381;&#2359;&#2339;&#2379;&#2306; &#2325;&#2366; &#2348;&#2361;&#2369;&#2354;&#2325; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p>", "options_en": ["41", "48", "45", "49"], "options_hi": ["41", "48", "45", "49"], "answer": 0, "solution_en": "<p>Mean of 13 observations = 50</p><p>Median of 13 observations = 47</p><p>Since, we know that-</p><p>Mode = 3*median  -  2*mean</p><p>= 3*47  -  2*50</p><p>= 141  -  100</p><p>= 41</p>", "solution_hi": "<p>Mean of 13 observations = 50</p><p>Median of 13 observations = 47</p><p>Since, we know that-</p><p>Mode = 3*median  -  2*mean</p><p>= 3*47  -  2*50</p><p>= 141  -  100</p><p>= 41</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>The median of a set of 15 distinct number is 61. If each of the largest 7 observations of the set is increased by 10, then the median of the new set:</p>", "q_hi": "<p>15 &#2309;&#2354;&#2327;-&#2309;&#2354;&#2327; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2323;&#2306; &#2325;&#2375; &#2319;&#2325; &#2360;&#2375;&#2335; &#2325;&#2368; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; 61 &#2361;&#2376;&#2404; &#2351;&#2342;&#2367; &#2360;&#2375;&#2335; &#2325;&#2375; &#2360;&#2348;&#2360;&#2375; &#2348;&#2337;&#2364;&#2375; 7 &#2346;&#2381;&#2352;&#2375;&#2325;&#2381;&#2359;&#2339;&#2379;&#2306; &#2350;&#2375;&#2306; &#2360;&#2375; &#2346;&#2381;&#2352;&#2340;&#2381;&#2351;&#2375;&#2325; &#2350;&#2375;&#2306; 10 &#2325;&#2368; &#2357;&#2371;&#2342;&#2381;&#2343;&#2367; &#2325;&#2368; &#2332;&#2366;&#2340;&#2368; &#2361;&#2376;, &#2340;&#2379; &#2344;&#2319; &#2360;&#2375;&#2335; &#2325;&#2368; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366;:</p>", "options_en": ["15 times that of the original median", "increased by 15", "Remains the same as that of original set", "decreased by 15"], "options_hi": ["&#2350;&#2370;&#2354; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; &#2325;&#2366; 15 &#2327;&#2369;&#2344;&#2366;", "15 &#2325;&#2368; &#2357;&#2371;&#2342;&#2381;&#2343;&#2367; &#2361;&#2369;&#2312;", "&#2350;&#2370;&#2354; &#2360;&#2375;&#2335; &#2325;&#2375; &#2360;&#2350;&#2366;&#2344; &#2361;&#2368; &#2352;&#2361;&#2340;&#2366; &#2361;&#2376;", "15 &#2360;&#2375; &#2325;&#2350;"], "answer": 2, "solution_en": "<p>Total number of observations = 15</p><p>So median will be the 8<sup>th</sup> term.</p><p>When the largest 7 observation of the set is increased by 10 then the 7 numbers after the median will increase and median always will be the 8<sup>th</sup> term.</p><p>Therefore, median remains the same as that of original set.</p>", "solution_hi": "<p>Total number of observations = 15</p><p>So median will be the 8<sup>th</sup> term.</p><p>When the largest 7 observation of the set is increased by 10 then the 7 numbers after the median will increase and median always will be the 8<sup>th</sup> term.</p><p>Therefore, median remains the same as that of original set.</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>The median of the data 40, 55, 50, 51, 72, 79, 68, 39, and 71 is X. If we replace 50 with 80, then the new median will be Y. Find the difference between the values of X and Y.</p>", "q_hi": "<p>&#2310;&#2306;&#2325;&#2337;&#2364;&#2379;&#2306; 40, 55, 50, 51, 72, 79, 68, 39 &#2324;&#2352; 71 &#2325;&#2366; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; X &#2361;&#2376;&#2404; &#2351;&#2342;&#2367; &#2361;&#2350; 50 &#2325;&#2375; &#2360;&#2381;&#2341;&#2366;&#2344; &#2346;&#2352; 80 &#2352;&#2326;&#2375;&#2306;, &#2340;&#2379; &#2344;&#2351;&#2366; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; Y &#2361;&#2379;&#2327;&#2366;&#2404; X &#2324;&#2352; Y &#2325;&#2375; &#2350;&#2366;&#2344;&#2379;&#2306; &#2325;&#2375; &#2348;&#2368;&#2330; &#2309;&#2306;&#2340;&#2352; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p>", "options_en": ["13", "11", "3", "23"], "options_hi": ["13", "11", "3", "23"], "answer": 0, "solution_en": "<p>Data in ascending order = 39, 40, 50, 51, 55, 68, 71, 72, and 79 = 9 terms</p><p>So, median (X) = 55</p><p>New data after replacing 50 with 80 = 39, 40, 51, 55, 68, 71, 72, 79, and 80</p><p>So, Median(Y) = 68</p><p>Required answer = 68  -  55 = 13</p>", "solution_hi": "<p>Data in ascending order = 39, 40, 50, 51, 55, 68, 71, 72, and 79 = 9 terms</p><p>So, median (X) = 55</p><p>New data after replacing 50 with 80 = 39, 40, 51, 55, 68, 71, 72, 79, and 80</p><p>So, Median(Y) = 68</p><p>Required answer = 68  -  55 = 13</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>If P = 22, 24, 22, 21, 24, 23, 22, 24, 21, 21, 24, 25, 22, 24 and Q = 22, 23, 21, 25, 25, 23, 24, 21, 24, 24, 24, 22, 22, 22, 22 then which of the following statement/s is/are true?</p><p>(I) Mode of P = Mode of Q - 2</p><p>(II) Mode of P = 2 + Mode of Q</p>", "q_hi": "<p>&#2351;&#2342;&#2367; P = 22, 24, 22, 21, 24, 23, 22, 24, 21, 21, 24, 25, 22, 24 &#2324;&#2352; Q = 22, 23, 21, 25, 25, 23, 24, 21, 24, 24, 24, 22, 22, 22, 22 &#2340;&#2379; &#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2350;&#2375;&#2306; &#2360;&#2375; &#2325;&#2380;&#2344; &#2360;&#2366; &#2325;&#2341;&#2344; &#2360;&#2340;&#2381;&#2351; &#2361;&#2376;?</p><p>(I) P &#2325;&#2366; &#2348;&#2361;&#2369;&#2354;&#2325; = Q &#2325;&#2366; &#2348;&#2361;&#2369;&#2354;&#2325; - 2</p><p>(II) P &#2325;&#2366; &#2348;&#2361;&#2369;&#2354;&#2325; = 2 &#8203;&#8203;+ Q &#2325;&#2366; &#2348;&#2361;&#2369;&#2354;&#2325;</p>", "options_en": ["Only I", "Only II", "Neither I nor II", "Cannot be determined"], "options_hi": ["&#2325;&#2375;&#2357;&#2354; I", "&#2325;&#2375;&#2357;&#2354; II", "&#2344; &#2340;&#2379; I &#2324;&#2352; &#2344; &#2361;&#2368; II", "&#2340;&#2351; &#2344;&#2361;&#2368;&#2306; &#2325;&#2367;&#2351;&#2366; &#2332;&#2366; &#2360;&#2325;&#2340;&#2366;"], "answer": 1, "solution_en": "<p>Mode of P = 24 as 24 has the highest frequency among other terms</p><p>Mode of Q = 22 as 22 has the highest frequency among other terms</p><p>So,</p><p>Mode of P = Mode of Q + 2</p><p>Statement II is true.</p>", "solution_hi": "<p>Mode of P = 24 as 24 has the highest frequency among other terms</p><p>Mode of Q = 22 as 22 has the highest frequency among other terms</p><p>So,</p><p>Mode of P = Mode of Q + 2</p><p>Statement II is true.</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>Find the range of the following data:</p><p>32, 30, 70, 53, 43, 76, 108, 30, 24, 54, 48, 42, 65, 97, 109, 22, 75, 61, 50, 52</p>", "q_hi": "<p>&#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2337;&#2375;&#2335;&#2366; &#2325;&#2368; &#2360;&#2368;&#2350;&#2366; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2352;&#2375;&#2306;:</p><p>32, 30, 70, 53, 43, 76, 108, 30, 24, 54, 48, 42, 65, 97, 109, 22, 75, 61, 50, 52</p>", "options_en": ["87", "85", "82", "95"], "options_hi": ["87", "85", "82", "95"], "answer": 0, "solution_en": "<p>Minimum term = 22</p><p>Maximum term = 109</p><p>Range = maximum  -  minimum = 109  -  22 = 87</p>", "solution_hi": "<p>Minimum term = 22</p><p>Maximum term = 109</p><p>Range = maximum  -  minimum = 109  -  22 = 87</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>If the variance of some observations is 320.41, then find the standard deviation of those observations.</p>", "q_hi": "<p>&#2351;&#2342;&#2367; &#2325;&#2369;&#2331; &#2346;&#2381;&#2352;&#2375;&#2325;&#2381;&#2359;&#2339;&#2379;&#2306; &#2325;&#2366; &#2346;&#2381;&#2352;&#2360;&#2352;&#2339; 320.41 &#2361;&#2376;, &#2340;&#2379; &#2313;&#2344; &#2346;&#2381;&#2352;&#2375;&#2325;&#2381;&#2359;&#2339;&#2379;&#2306; &#2325;&#2366; &#2350;&#2366;&#2344;&#2325; &#2357;&#2367;&#2330;&#2354;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p>", "options_en": ["19.9", "16.9", "18.9", "17.9"], "options_hi": ["19.9", "16.9", "18.9", "17.9"], "answer": 3, "solution_en": "<p>We know that standard deviation of observations is equal to square root of variance of those observations.</p><p>&#963; = &radic;320.41</p><p>&#963; = &radic; (32041/100)</p><p>&#963; = 179/10 = 17.9</p>", "solution_hi": "<p>We know that standard deviation of observations is equal to square root of variance of those observations.</p><p>&#963; = &radic;320.41</p><p>&#963; = &radic; (32041/100)</p><p>&#963; = 179/10 = 17.9</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>If the standard deviation of a given data is 0.52, then find the variance of that data.</p>", "q_hi": "<p>&#2351;&#2342;&#2367; &#2325;&#2367;&#2360;&#2368; &#2342;&#2367;&#2319; &#2327;&#2319; &#2337;&#2375;&#2335;&#2366; &#2325;&#2366; &#2350;&#2366;&#2344;&#2325; &#2357;&#2367;&#2330;&#2354;&#2344; 0.52 &#2361;&#2376;, &#2340;&#2379; &#2313;&#2360; &#2337;&#2375;&#2335;&#2366; &#2325;&#2366; &#2346;&#2381;&#2352;&#2360;&#2352;&#2339; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p>", "options_en": ["0.2704", "0.3124", "0.2744", "0.3144"], "options_hi": ["0.2704", "0.3124", "0.2744", "0.3144"], "answer": 0, "solution_en": "<p>We know that standard deviation of observations is equal to square root of variance of those observations.</p><p>Given,</p><p>0.52 = &radic;Variance</p><p>Variance = 0.52 * 0.52 = 0.2704</p>", "solution_hi": "<p>We know that standard deviation of observations is equal to square root of variance of those observations.</p><p>Given,</p><p>0.52 = &radic;Variance</p><p>Variance = 0.52 * 0.52 = 0.2704</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>The mean of five numbers (3a+20), 15, (2a-15), (17+a) and 31 is 22, find the value of a.</p>", "q_hi": "<p>&#2346;&#2366;&#2306;&#2330; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2323;&#2306; (3a+20), 15, (2a-15), (17+a) &#2324;&#2352; 31 &#2325;&#2366; &#2350;&#2366;&#2343;&#2381;&#2351; 22 &#2361;&#2376;, a &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p>", "options_en": ["9", "10", "11", "7"], "options_hi": ["9", "10", "11", "7"], "answer": 3, "solution_en": "<p>Mean = 22</p><p>(3a + 20 + 15 + 2a  -  15 + 17 + a + 31)/5 = 22</p><p>6a + 68 = 110</p><p>6a = 42</p><p>a = 7</p>", "solution_hi": "<p>Mean = 22</p><p>(3a + 20 + 15 + 2a  -  15 + 17 + a + 31)/5 = 22</p><p>6a + 68 = 110</p><p>6a = 42</p><p>a = 7</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>If the median of numbers given in ascending order is 80 then find the value of m.</p><p>46, 58, 70, m+38, 2m-33, 117</p>", "q_hi": "<p>&#2351;&#2342;&#2367; &#2310;&#2352;&#2379;&#2361;&#2368; &#2325;&#2381;&#2352;&#2350; &#2350;&#2375;&#2306; &#2342;&#2368; &#2327;&#2312; &#2360;&#2306;&#2326;&#2381;&#2351;&#2366;&#2323;&#2306; &#2325;&#2366; &#2350;&#2366;&#2343;&#2381;&#2351; 80 &#2361;&#2376; &#2340;&#2379; m &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p><p>46, 58, 70, m+38, 2m-33, 117</p>", "options_en": ["55", "52", "53", "59"], "options_hi": ["55", "52", "53", "59"], "answer": 1, "solution_en": "<p>Since n = 6 (even number)</p><p>So, median = &frac12; * [3rd term + 4th term] = 80</p><p>&frac12; * (70+m+38) = 80</p><p>108 + m = 160</p><p>m = 52</p>", "solution_hi": "<p>Since n = 6 (even number)</p><p>So, median = &frac12; * [3rd term + 4th term] = 80</p><p>&frac12; * (70+m+38) = 80</p><p>108 + m = 160</p><p>m = 52</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>What is the mean of the median and the mode of the data?</p><p>29, 30, 24, 25, 29, 26, 27, 25, 24, 23, 28, 29, 27</p>", "q_hi": "<p>&#2310;&#2306;&#2325;&#2337;&#2364;&#2379;&#2306; &#2325;&#2368; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; &#2324;&#2352; &#2348;&#2361;&#2369;&#2354;&#2325; &#2325;&#2366; &#2350;&#2366;&#2343;&#2381;&#2351; &#2325;&#2381;&#2351;&#2366; &#2361;&#2376;?</p><p>29, 30, 24, 25, 29, 26, 27, 25, 24, 23, 28, 29, 27</p>", "options_en": ["28", "27", "29", "30"], "options_hi": ["28", "27", "29", "30"], "answer": 0, "solution_en": "<p>Data in ascending order: 23, 24, 24, 25, 25, 26, 27, 27, 28, 29, 29, 29, 30</p><p>Median = 7<sup>th</sup> term = 27</p><p>Mode = Higher frequency term = 29</p><p>Required mean = (27 + 29)/2 = 56/2 = 28</p>", "solution_hi": "<p>Data in ascending order: 23, 24, 24, 25, 25, 26, 27, 27, 28, 29, 29, 29, 30</p><p>Median = 7<sup>th</sup> term = 27</p><p>Mode = Higher frequency term = 29</p><p>Required mean = (27 + 29)/2 = 56/2 = 28</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>If the ratio of the mode and median of a certain data is 11: 7, then the ratio of its mean and median is:</p>", "q_hi": "<p>&#2351;&#2342;&#2367; &#2325;&#2367;&#2360;&#2368; &#2344;&#2367;&#2358;&#2381;&#2330;&#2367;&#2340; &#2337;&#2375;&#2335;&#2366; &#2325;&#2375; &#2348;&#2361;&#2369;&#2354;&#2325; &#2324;&#2352; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; &#2325;&#2366; &#2309;&#2344;&#2369;&#2346;&#2366;&#2340; 11: 7 &#2361;&#2376;, &#2340;&#2379; &#2313;&#2360;&#2325;&#2375; &#2350;&#2366;&#2343;&#2381;&#2351; &#2324;&#2352; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; &#2325;&#2366; &#2309;&#2344;&#2369;&#2346;&#2366;&#2340; &#2325;&#2381;&#2351;&#2366; &#2361;&#2379;&#2327;&#2366;:</p>", "options_en": ["5: 7", "3: 5", "7: 5", "5: 3"], "options_hi": ["5: 7", "3: 5", "7: 5", "5: 3"], "answer": 0, "solution_en": "<p>Let the mode and median be 11a and 7a respectively.</p><p>We know that</p><p>Mode = 3 x Median  -  2 x Mean</p><p>11a = 21a  -  2 x mean</p><p>2 x mean = 10a</p><p>Mean = 5a</p><p>Required Ratio = 5a: 7a = 5: 7</p>", "solution_hi": "<p>Let the mode and median be 11a and 7a respectively.</p><p>We know that</p><p>Mode = 3 x Median  -  2 x Mean</p><p>11a = 21a  -  2 x mean</p><p>2 x mean = 10a</p><p>Mean = 5a</p><p>Required Ratio = 5a: 7a = 5: 7</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>If the difference of the mode and median of a date is 41, then the difference of the median and mean is?</p>", "q_hi": "<p>&#2351;&#2342;&#2367; &#2325;&#2367;&#2360;&#2368; &#2340;&#2367;&#2341;&#2367; &#2325;&#2375; &#2348;&#2361;&#2369;&#2354;&#2325; &#2324;&#2352; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; &#2325;&#2366; &#2309;&#2306;&#2340;&#2352; 41 &#2361;&#2376;, &#2340;&#2379; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; &#2324;&#2352; &#2350;&#2366;&#2343;&#2381;&#2351;&#2367;&#2325;&#2366; &#2325;&#2366; &#2309;&#2306;&#2340;&#2352; &#2325;&#2381;&#2351;&#2366; &#2361;&#2376;?</p>", "options_en": ["21", "20.5", "19", "19.5"], "options_hi": ["21", "20.5", "19", "19.5"], "answer": 1, "solution_en": "<p>Given that,</p><p>Mode  -  Median = 41</p><p>Mode = 41 + Median</p><p>We know that,</p><p>Mode = 3 x Median  -  2 x Mean</p><p>41 + Median = 3 x Median  -  2 x Mean</p><p>41 = 2 x Median  -  2 x Mean</p><p>Median  -  Mean = 41/2 = 20.5</p>", "solution_hi": "<p>Given that,</p><p>Mode  -  Median = 41</p><p>Mode = 41 + Median</p><p>We know that,</p><p>Mode = 3 x Median  -  2 x Mean</p><p>41 + Median = 3 x Median  -  2 x Mean</p><p>41 = 2 x Median  -  2 x Mean</p><p>Median  -  Mean = 41/2 = 20.5</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>The following table shows the frequency distribution of marks obtained by 100 students in a class test. Find the mean of the marks.</p><table style=\"border-collapse:collapse;\"><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">Class Interval</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">Frequency</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">0-10</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">15</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">10-20</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">18</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">20-30</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">22</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">30-40</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">25</td></tr><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">40-50</td><td align=\"left\" style=\"border:1px solid black;padding:5px;\">20</td></tr></table>", "q_hi": "<p>&#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2340;&#2366;&#2354;&#2367;&#2325;&#2366; &#2319;&#2325; &#2325;&#2325;&#2381;&#2359;&#2366; &#2346;&#2352;&#2368;&#2325;&#2381;&#2359;&#2366; &#2350;&#2375;&#2306; 100 &#2331;&#2366;&#2340;&#2381;&#2352;&#2379;&#2306; &#2342;&#2381;&#2357;&#2366;&#2352;&#2366; &#2346;&#2381;&#2352;&#2366;&#2346;&#2381;&#2340; &#2309;&#2306;&#2325;&#2379;&#2306; &#2325;&#2366; &#2310;&#2357;&#2371;&#2340;&#2381;&#2340;&#2367; &#2357;&#2367;&#2340;&#2352;&#2339; &#2342;&#2352;&#2381;&#2358;&#2366;&#2340;&#2368; &#2361;&#2376;&#2404; &#2309;&#2306;&#2325;&#2379;&#2306; &#2325;&#2366; &#2324;&#2360;&#2340; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2352;&#2375;&#2306;&#2404;</p><table style=\"border-collapse:collapse;\"><tr><td align=\"left\" style=\"border:1px solid black;padding:5px;\">&#2357;&#2352;&#2381;&#2327; &#2309;&#2306;&#2340;&#2352;&#2366;&#2354;</td><td align=\"left\" style=\"border:1px