81;&#2352;&#2340;&#2367; &#2325;&#2367;&#2354;&#2379;&#2327;&#2381;&#2352;&#2366;&#2350; &#2350;&#2375;&#2306; &#2326;&#2352;&#2368;&#2342;&#2366; &#2341;&#2366;&#2404; &#2354;&#2375;&#2325;&#2367;&#2344; &#2327;&#2354;&#2340; &#2357;&#2332;&#2344; &#2325;&#2366; &#2313;&#2346;&#2351;&#2379;&#2327; &#2325;&#2352;&#2325;&#2375;, &#2357;&#2361; &#2360;&#2375;&#2348; &#2348;&#2375;&#2330;&#2340;&#2375; &#2360;&#2350;&#2351; 1 &#2325;&#2367;&#2354;&#2379;&#2327;&#2381;&#2352;&#2366;&#2350; &#2325;&#2375; &#2348;&#2332;&#2366;&#2351; &#2325;&#2375;&#2357;&#2354; 920 &#2327;&#2381;&#2352;&#2366;&#2350; &#2360;&#2375;&#2348; &#2342;&#2375;&#2340;&#2366; &#2361;&#2376;&#2404; &#2357;&#2367;&#2325;&#2381;&#2352;&#2375;&#2340;&#2366; &#2342;&#2381;&#2357;&#2366;&#2352;&#2366; &#2309;&#2352;&#2381;&#2332;&#2367;&#2340; &#2357;&#2366;&#2360;&#2381;&#2340;&#2357;&#2367;&#2325; &#2346;&#2381;&#2352;&#2340;&#2367;&#2358;&#2340; &#2354;&#2366;&#2349; &#2325;&#2381;&#2351;&#2366; &#2361;&#2376;?</p>", "options_en": ["22.21%", "19.56%", "17.57%", "20.06%"], "options_hi": ["22.21%", "19.56%", "17.57%", "20.06%"], "answer": 1, "solution_en": "<p>Cost price of 920 gm apples = 200*920/1000 = &#8377;184</p><p>Selling price of 920 gm apples = &#8377;220/kg</p><p>Profit percentage = [(220  -  184)/184]*100 = 19.56%</p>", "solution_hi": "<p>Cost price of 920 gm apples = 200*920/1000 = &#8377;184</p><p>Selling price of 920 gm apples = &#8377;220/kg</p><p>Profit percentage = [(220  -  184)/184]*100 = 19.56%</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>A dishonest man bought some vegetables at &#8377;50 per kg and sold one kg of the vegetables to Utkarsh and Bhanu at &#8377;60/kg and &#8377;56/kg respectively. He sold X gm to Utkarsh and (X + 10) gm to Bhanu instead of one kg using defective weight. If the profit made by selling the vegetables to both is &#8377;20.5, then find the value of X.</p>", "q_hi": "<p>&#2319;&#2325; &#2348;&#2375;&#2312;&#2350;&#2366;&#2344; &#2310;&#2342;&#2350;&#2368; &#2344;&#2375; &#2325;&#2369;&#2331; &#2360;&#2348;&#2381;&#2332;&#2364;&#2367;&#2351;&#2366;&#2305; &#8377;50 &#2346;&#2381;&#2352;&#2340;&#2367; &#2325;&#2367;&#2354;&#2379;&#2327;&#2381;&#2352;&#2366;&#2350; &#2325;&#2375; &#2361;&#2367;&#2360;&#2366;&#2348; &#2360;&#2375; &#2326;&#2352;&#2368;&#2342;&#2368;&#2306; &#2324;&#2352; &#2319;&#2325; &#2325;&#2367;&#2354;&#2379;&#2327;&#2381;&#2352;&#2366;&#2350; &#2360;&#2348;&#2381;&#2332;&#2364;&#2367;&#2351;&#2366;&#2305; &#2313;&#2340;&#2381;&#2325;&#2352;&#2381;&#2359; &#2324;&#2352; &#2349;&#2366;&#2344;&#2369; &#2325;&#2379; &#2325;&#2381;&#2352;&#2350;&#2358;&#2307; &#8377;60/&#2325;&#2367;&#2354;&#2379;&#2327;&#2381;&#2352;&#2366;&#2350; &#2324;&#2352; &#8377;56/&#2325;&#2367;&#2354;&#2379;&#2327;&#2381;&#2352;&#2366;&#2350; &#2325;&#2375; &#2361;&#2367;&#2360;&#2366;&#2348; &#2360;&#2375; &#2348;&#2375;&#2330;&#2368;&#2306;&#2404; &#2313;&#2360;&#2344;&#2375; &#2319;&#2325; &#2325;&#2367;&#2354;&#2379;&#2327;&#2381;&#2352;&#2366;&#2350; &#2325;&#2375; &#2348;&#2332;&#2366;&#2351; &#2313;&#2340;&#2381;&#2325;&#2352;&#2381;&#2359; &#2325;&#2379; X &#2327;&#2381;&#2352;&#2366;&#2350; &#2324;&#2352; &#2349;&#2366;&#2344;&#2369; &#2325;&#2379; (X + 10) &#2327;&#2381;&#2352;&#2366;&#2350; &#2348;&#2375;&#2330;&#2366;, &#2332;&#2348;&#2325;&#2367; &#2357;&#2332;&#2344; &#2350;&#2375;&#2306; &#2327;&#2337;&#2364;&#2348;&#2337;&#2364;&#2368; &#2341;&#2368;&#2404; &#2351;&#2342;&#2367; &#2342;&#2379;&#2344;&#2379;&#2306; &#2325;&#2379; &#2360;&#2348;&#2381;&#2332;&#2364;&#2367;&#2351;&#2366;&#2305; &#2348;&#2375;&#2330;&#2344;&#2375; &#2346;&#2352; &#2313;&#2360;&#2375; &#8377;20.5 &#2325;&#2366; &#2354;&#2366;&#2349; &#2361;&#2369;&#2310;, &#2340;&#2379; X &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p>", "options_en": ["980 gm", "940 gm", "950 gm", "960 gm"], "options_hi": ["980 &#2327;&#2381;&#2352;&#2366;&#2350;", "940 &#2327;&#2381;&#2352;&#2366;&#2350;", "950 &#2327;&#2381;&#2352;&#2366;&#2350;", "960 &#2327;&#2381;&#2352;&#2366;&#2350;"], "answer": 2, "solution_en": "<p>Cost price = &#8377;50/kg</p><p>Selling price of vegetable to Utkarsh = &#8377;60/kg</p><p>Selling price of vegetable to Bhanu = &#8377;56/kg</p><p>Total profit = &#8377;20.5</p><p>(60  -  50) + (56  -  50) + (1000  -  X) *50/1000 + (1000  -  X  -  10)*50/1000 = 20.5</p><p>10 + 6 + 100  -  X/10  -  0.5 = 20.5</p><p>X/10 = 95</p><p>X = 950 gm</p>", "solution_hi": "<p>Cost price = &#8377;50/kg</p><p>Selling price of vegetable to Utkarsh = &#8377;60/kg</p><p>Selling price of vegetable to Bhanu = &#8377;56/kg</p><p>Total profit = &#8377;20.5</p><p>(60  -  50) + (56  -  50) + (1000  -  X) *50/1000 + (1000  -  X  -  10)*50/1000 = 20.5</p><p>10 + 6 + 100  -  X/10  -  0.5 = 20.5</p><p>X/10 = 95</p><p>X = 950 gm</p>", "marks": 1.0, "neg": 0.25}, {"q_en": "<p>A man buys some quantity of milk at &#8377;90 per litre. He sold one litre of milk to Uday and Rachit each at 100/litre. He sold 950 ml to Uday and 800 ml to Rachit instead of one litre using false weight. Find the profit made by selling the milk to Uday and Rachit together.</p>", "q_hi": "<p>&#2319;&#2325; &#2310;&#2342;&#2350;&#2368; &#2325;&#2369;&#2331; &#2350;&#2366;&#2340;&#2381;&#2352;&#2366; &#2350;&#2375;&#2306; &#2342;&#2370;&#2343; &#8377;90 &#2346;&#2381;&#2352;&#2340;&#2367; &#2354;&#2368;&#2335;&#2352; &#2325;&#2375; &#2361;&#2367;&#2360;&#2366;&#2348; &#2360;&#2375; &#2326;&#2352;&#2368;&#2342;&#2340;&#2366; &#2361;&#2376;&#2404; &#2313;&#2360;&#2344;&#2375; &#2313;&#2342;&#2351; &#2324;&#2352; &#2352;&#2330;&#2367;&#2340; &#2325;&#2379; &#2319;&#2325;-&#2319;&#2325; &#2354;&#2368;&#2335;&#2352; &#2342;&#2370;&#2343; 100/&#2354;&#2368;&#2335;&#2352; &#2325;&#2375; &#2361;&#2367;&#2360;&#2366;&#2348; &#2360;&#2375; &#2348;&#2375;&#2330;&#2366;&#2404; &#2313;&#2360;&#2344;&#2375; &#2327;&#2354;&#2340; &#2357;&#2332;&#2344; &#2325;&#2366; &#2311;&#2360;&#2381;&#2340;&#2375;&#2350;&#2366;&#2354; &#2325;&#2352;&#2325;&#2375; &#2319;&#2325; &#2354;&#2368;&#2335;&#2352; &#2325;&#2375; &#2348;&#2332;&#2366;&#2351; &#2313;&#2342;&#2351; &#2325;&#2379; 950 &#2350;&#2367;&#2354;&#2368; &#2354;&#2368;&#2335;&#2352; &#2324;&#2352; &#2352;&#2330;&#2367;&#2340; &#2325;&#2379; 800 &#2350;&#2367;&#2354;&#2368; &#2354;&#2368;&#2335;&#2352; &#2342;&#2370;&#2343; &#2348;&#2375;&#2330;&#2366;&#2404; &#2313;&#2342;&#2351; &#2324;&#2352; &#2352;&#2330;&#2367;&#2340; &#2325;&#2379; &#2319;&#2325; &#2360;&#2366;&#2341; &#2342;&#2370;&#2343; &#2348;&#2375;&#2330;&#2344;&#2375; &#2346;&#2352; &#2361;&#2379;&#2344;&#2375; &#2357;&#2366;&#2354;&#2366; &#2354;&#2366;&#2349; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p>", "options_en": ["&#8377;42.5", "&#8377;36.5", "&#8377;45.5", "&#8377;32.5"], "options_hi": ["&#8377;42.5", "&#8377;36.5", "&#8377;45.5", "&#8377;32.5"], "answer": 0, "solution_en": "<p>Cost price of milk = &#8377;90/kg</p><p>Selling price of Uday and Rachit each = &#8377;100/kg</p><p>Total profit = 2(100  -  90) + (1000  -  950)*90/1000 + (1000  -  800)*90/1000</p><p>= 20 + 2.5*9 </p><p>= 20 + 22.5</p><p>= &#8377;42.5</p>", "solution_hi": "<p>Cost price of milk = &#8377;90/kg</p><p>Selling price of Uday and Rachit each = &#8377;100/kg</p><p>Total profit = 2(100  -  90) + (1000  -  950)*90/1000 + (1000  -  800)*90/1000</p><p>= 20 + 2.5*9 </p><p>= 20 + 22.5</p><p>= &#8377;42.5</p>", "marks": 1.0, "neg": 0.25}]}