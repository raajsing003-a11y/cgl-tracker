   "q_hi": "<p>&#2342;&#2367;&#2319; &#2327;&#2319; &#2360;&#2350;&#2354;&#2306;&#2348; &#2350;&#2375;&#2306;, D &#2325;&#2366; &#2350;&#2366;&#2344; &#2325;&#2381;&#2351;&#2366; &#2361;&#2376;?</p><p><img width=\"248\" height=\"103\" id=\"Picture 5\" src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p3031/image004.png\"></p>",
