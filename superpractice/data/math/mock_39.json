lack; text-align:center\">6</span></div>&nbsp;- (&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">1</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">3</span></div>&nbsp;+&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">1</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">2</span></div>&nbsp;))]}&nbsp;</div></p><p></p>", "q_hi": "<p><div>&nbsp;&#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2352;&#2375;&#2306;  : 9 &div; {1 + [4 x (&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">5</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">6</span></div>&nbsp;- (&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">1</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">3</span></div>&nbsp;+&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">1</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">2</span></div>&nbsp;))]}&nbsp;</div></p><p></p>", "options_en": ["1", "9/5", "0", "9"], "options_hi": ["1", "9/5", "0", "9"], "answer": 3, "solution_en": "<p>9 &div; {1 + [4 * (5/6  -  (1/3 + 1/2))]} </p><p>=&gt; 9 &div; {1 + [4 * (5/6  -  5/6)]}</p><p>=&gt; 9 &div; {1 + [4 * 0]</p><p>=&gt; 9 &div; {1 + 0}</p><p>=&gt; 9 &div; 1 = 9</p>", "solution_hi": "<p>9 &div; {1 + [4 * (5/6  -  (1/3 + 1/2))]} </p><p>=&gt; 9 &div; {1 + [4 * (5/6  -  5/6)]}</p><p>=&gt; 9 &div; {1 + [4 * 0]</p><p>=&gt; 9 &div; {1 + 0}</p><p>=&gt; 9 &div; 1 = 9</p>"}, {"q_en": "<p>Simplify: [25 &#8722;48 &div; 6 + 12  X  2] + 78  -  [5 + 3 of (25  -  2  X  10)]</p>", "q_hi": "<p>&#2360;&#2352;&#2354;&#2368;&#2325;&#2371;&#2340; &#2325;&#2352;&#2375;&#2306;: [25 &#8722;48 &div; 6 + 12 X 2] + 78 - [5 + 3 of (25 - 2 X 10)]</p>", "options_en": ["98", "90", "99", "89"], "options_hi": ["98", "90", "99", "89"], "answer": 2, "solution_en": "<p>We have the equation as:-</p><p>[25 &#8722;48 &div; 6 + 12  X  2] + 78  -  [5 + 3 of (25  -  2  X  10)]</p><p>= [25 &#8722;8 + 24] + 78  -  [5 + 3 of (5)]</p><p>= [41] + 78  -  [20]</p><p>= 119  -  20 </p><p>= 99</p><p>Option (c) is the correct answer.</p>", "solution_hi": "<p>We have the equation as:-</p><p>[25 &#8722;48 &div; 6 + 12  X  2] + 78  -  [5 + 3 of (25  -  2  X  10)]</p><p>= [25 &#8722;8 + 24] + 78  -  [5 + 3 of (5)]</p><p>= [41] + 78  -  [20]</p><p>= 119  -  20 </p><p>= 99</p><p>Option (c) is the correct answer.</p>"}, {"q_en": "<p>The value of N in the equation 9  X  N of 4 &div; 4 - 15  X  4 = 12 is:</p>", "q_hi": "&#2360;&#2350;&#2368;&#2325;&#2352;&#2339; 9 X N &#2325;&#2375; 4 &div; 4 - 15 X 4 = 12 &#2350;&#2375;&#2306; N &#2325;&#2366; &#2350;&#2366;&#2344; &#2361;&#2376;:", "options_en": ["9", "0", "12", "8"], "options_hi": ["9", "0", "12", "8"], "answer": 3, "solution_en": "<p>9  X  N of 4 &div; 4 - 15  X  4 = 12</p><p>9N of 4/4  -  60 = 12</p><p>9N  -  60 = 12</p><p>9N = 72</p><p>N = 8</p>", "solution_hi": "<p>9  X  N of 4 &div; 4 - 15  X  4 = 12</p><p>9N of 4/4  -  60 = 12</p><p>9N  -  60 = 12</p><p>9N = 72</p><p>N = 8</p>"}, {"q_en": "<p><div>&nbsp;If&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">3(16<sup>3</sup> - 6<sup>3</sup>)</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">16<sup>2</sup> + 6<sup>2</sup> + Q</span></div>&nbsp;= 30, then find the value of Q&nbsp;</div></p><p></p>", "q_hi": "<p><div>&nbsp;&#2351;&#2342;&#2367; &nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">3(16<sup>3</sup> - 6<sup>3</sup>)</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">16<sup>2</sup> + 6<sup>2</sup> + Q</span></div>&nbsp;= 30, &#2340;&#2379; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2352;&#2375;&#2306;   Q&nbsp;</div></p><p></p>", "options_en": ["96", "98", "112", "108"], "options_hi": ["96", "98", "112", "108"], "answer": 0, "solution_en": "<p>we have the equation as:-</p><p>3(16<sup>3</sup>  -  6<sup>3</sup>)/(16<sup>2</sup> + 6<sup>2</sup> + Q) = 30</p><p>3(4096  -  216)/(292 + Q) = 30</p><p>3880=2920 + 10Q</p><p>960=10Q</p><p>Q=96</p><p>Option (a) is the correct answer.</p>", "solution_hi": "<p>we have the equation as:-</p><p>3(16<sup>3</sup>  -  6<sup>3</sup>)/(16<sup>2</sup> + 6<sup>2</sup> + Q) = 30</p><p>3(4096  -  216)/(292 + Q) = 30</p><p>3880=2920 + 10Q</p><p>960=10Q</p><p>Q=96</p><p>Option (a) is the correct answer.</p>"}, {"q_en": "<p>Simplify the expression: (60 + 64 &div; 4 of 4)  X  {1000 &div; ((10 of (3 + 2))  X  2 of 5)} &#8722; 28 + (100  X  3 of 3)</p>", "q_hi": "<p>&#2357;&#2381;&#2351;&#2306;&#2332;&#2325; &#2325;&#2379; &#2360;&#2352;&#2354; &#2325;&#2352;&#2375;&#2306;: (60 + 64 &div; 4 of 4) X {1000 &div; ((10 of (3 + 2)) X 2 of 5)} &#8722; 28 + (100 X 3 of 3)</p>", "options_en": ["600", "1000", "100", "500"], "options_hi": ["600", "1000", "100", "500"], "answer": 1, "solution_en": "<p>First bracket:</p><p>&#8195;&#8195;Compute 64 &div; (4  X  4) = 64 &div; 16 = 4, then 60 + 4 = 64.</p><p>Second bracket (curly braces):</p><p>&#8195;Evaluate (3 + 2) = 5, then 10  X  5 = 50.</p><p>&#8195;Evaluate 2  X  5 = 10.</p><p>Their product: 50  X  10 = 500.</p><p>Then 1000 &div; 500 = 2.</p><p>Third term:</p><p>&#8195;&#8195;3 of 3 = 3  X  3 = 9, then 100  X  9 = 900.</p><p>Combine all parts:</p><p>&#8195;&#8195;First term: 64  X  2 = 128.</p><p>&#8195;&#8195;Then: 128 &#8722; 28 = 100.</p><p>&#8195;&#8195;Finally: 100 + 900 = 1000.</p><p>Option (b) is the correct answer.</p>", "solution_hi": "<p>First bracket:</p><p>&#8195;&#8195;Compute 64 &div; (4  X  4) = 64 &div; 16 = 4, then 60 + 4 = 64.</p><p>Second bracket (curly braces):</p><p>&#8195;Evaluate (3 + 2) = 5, then 10  X  5 = 50.</p><p>&#8195;Evaluate 2  X  5 = 10.</p><p>Their product: 50  X  10 = 500.</p><p>Then 1000 &div; 500 = 2.</p><p>Third term:</p><p>&#8195;&#8195;3 of 3 = 3  X  3 = 9, then 100  X  9 = 900.</p><p>Combine all parts:</p><p>&#8195;&#8195;First term: 64  X  2 = 128.</p><p>&#8195;&#8195;Then: 128 &#8722; 28 = 100.</p><p>&#8195;&#8195;Finally: 100 + 900 = 1000.</p><p>Option (b) is the correct answer.</p>"}, {"q_en": "<p>Simplify 626  X  2912 &div; 8138</p>", "q_hi": "626 x 2912 &div; 8138 &#2325;&#2379; &#2360;&#2352;&#2354; &#2325;&#2352;&#2375;&#2306;", "options_en": ["285", "224", "364", "310"], "options_hi": ["285", "224", "364", "310"], "answer": 1, "solution_en": "<p>8138 &div; 626 = 13</p><p>So, the expression becomes:</p><p>(626  X  2912) &div; (626  X  13) = 2912 &div; 13</p><p>Now, 13  X  224 = 2912.</p><p>Thus, the simplified value is 224.</p><p>Option (b) is the correct answer.</p>", "solution_hi": "<p>8138 &div; 626 = 13</p><p>So, the expression becomes:</p><p>(626  X  2912) &div; (626  X  13) = 2912 &div; 13</p><p>Now, 13  X  224 = 2912.</p><p>Thus, the simplified value is 224.</p><p>Option (b) is the correct answer.</p>"}]}