/solution/oliveimg/p16025/image040.png\"></p><p><img width=167 height=40 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p16025/image041.png\"></p><p><img width=139 height=40 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p16025/image042.png\"></p><p><img width=112 height=17 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p16025/image043.png\"></p><p><img width=67 height=41 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p16025/image044.png\"></p><p><img width=168 height=57 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p16025/image045.png\"></p><p><img width=68 height=47 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p16025/image046.png\"></p>"}, {"q_en": "<p>Find the value of:</p><p><div><div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">sec &theta; (sin<sup>4</sup> &theta; - 1 + cos<sup>2</sup> &theta;)</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">sin 2&theta;</span></div></div></p><p></p>", "q_hi": "<p>&#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319; :</p><p><div><div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">sec &theta; (sin<sup>4</sup> &theta; - 1 + cos<sup>2</sup> &theta;)</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">sin 2&theta;</span></div></div></p><p></p>", "options_en": ["(-sin&#952;)/2", "-sin&#952;", "-sin2&#952;", "-1"], "options_hi": ["(-sin&#952;)/2", "-sin&#952;", "-sin2&#952;", "-1"], "answer": 0, "solution_en": "<p><img width=184 height=281 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p12372/image004.png\"></p>", "solution_hi": "<p><img width=184 height=281 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p12372/image004.png\"></p>"}, {"q_en": "<p><div>&nbsp;The expression equal to <div style='display: inline-block;position: relative;vertical-align: middle;'><span style='text-align:center;display: block; padding: 0;'>tan 53&deg; + cot 33&deg;</span><span style='display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;'>_________</span><span style='display: block; padding: 0;border-top: thin solid black; text-align:center'>tan 33&deg; + cot 53&deg;</span></div> is equal to&nbsp;</div></p><p></p>", "q_hi": "<p><div>&#2357;&#2381;&#2351;&#2306;&#2332;&#2325; <div style='display: inline-block;position: relative;vertical-align: middle;'><span style='text-align:center;display: block; padding: 0;'>tan 53&deg; + cot 33&deg;</span><span style='display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;'>_________</span><span style='display: block; padding: 0;border-top: thin solid black; text-align:center'>tan 33&deg; + cot 53&deg;</span></div> &#2325;&#2366; &#2350;&#2366;&#2344; &#2325;&#2367;&#2360;&#2325;&#2375; &#2348;&#2352;&#2366;&#2348;&#2352; &#2361;&#2376;?</div></p>", "options_en": ["tan 33&deg; cot 57&deg;", "tan 37&deg; cot 57&deg;", "tan 57&deg; cot 37&deg;", "tan 37&deg; cot 57&deg;"], "options_hi": ["tan 33&deg; cot 57&deg;", "tan 37&deg; cot 57&deg;", "tan 57&deg; cot 37&deg;", "tan 37&deg; cot 57&deg;"], "answer": 2, "solution_en": "<p>=(tan53&deg;+cot33&deg;)/(tan33&deg;+cot53&deg;)</p><p>= (tan53&deg;+(1/tan33))/(tan33&deg;+(1/tan53))</p><p>= (tan53&deg;tan33&deg;+1)/tan33&deg; X tan53&deg;/(1+tan53&deg;tan33&deg;)</p><p>= (tan53&deg;)/tan33&deg;</p><p>= tan53&deg; cot33&deg;</p><p>= cot37&deg; tan57&deg;</p>", "solution_hi": "<p>=(tan53&deg;+cot33&deg;)/(tan33&deg;+cot53&deg;)</p><p>= (tan53&deg;+(1/tan33))/(tan33&deg;+(1/tan53))</p><p>= (tan53&deg;tan33&deg;+1)/tan33&deg; X tan53&deg;/(1+tan53&deg;tan33&deg;)</p><p>= (tan53&deg;)/tan33&deg;</p><p>= tan53&deg; cot33&deg;</p><p>= cot37&deg; tan57&deg;</p>"}, {"q_en": "<p><div>&nbsp;The value of&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">sin15&deg;cos75&deg; + sec52&deg;sin38&deg; + sin75&deg;cos15&deg;</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">cosec<sup>2</sup>33&deg; - tan<sup>2</sup>57&deg;</span></div>&nbsp;is&#58;&nbsp;</div></p><p></p>", "q_hi": "<p><div><div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">sin15&deg;cos75&deg; + sec52&deg;sin38&deg; + sin75&deg;cos15&deg;</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">cosec<sup>2</sup>33&deg; - tan<sup>2</sup>57&deg;</span></div>&#2325;&#2366; &#2350;&#2366;&#2344; &#2361;&#2376;:</div></p>", "options_en": ["1", "2", "0", "1/2"], "options_hi": ["1", "2", "0", "1/2"], "answer": 1, "solution_en": "<p><img width=285 height=37 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image050.png\"></p><p><img width=421 height=45 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image051.png\"></p><p><img width=243 height=39 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image052.png\"></p><p><img width=44 height=36 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image053.png\"></p><p><img width=25 height=16 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image054.png\"></p>", "solution_hi": "<p><img width=285 height=37 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image050.png\"></p><p><img width=421 height=45 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image051.png\"></p><p><img width=243 height=39 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image052.png\"></p><p><img width=44 height=36 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image053.png\"></p><p><img width=25 height=16 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p19189/image054.png\"></p>"}, {"q_en": "<p><div>&nbsp;Find the value of (1 + cot A + tan A)(sin A - cos A)(&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">sin A cos A</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">sin<sup>3</sup> A - cos<sup>3</sup> A</span></div>&nbsp;)&nbsp;</div></p><p></p>", "q_hi": "<p><div>(1 + cot A + tan A)(sin A - cos A)( <div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">sin A cos A</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">sin<sup>3</sup> A - cos<sup>3</sup> A</span></div>) &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2351;&#2375;&#2404;</div></p>", "options_en": ["1", "-1", "0", "2"], "options_hi": ["1", "-1", "0", "2"], "answer": 0, "solution_en": "<p><img width=289 height=41 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image002.png\"></p><p><img width=316 height=41 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image003.png\"></p><p><img width=392 height=44 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image004.png\"></p><p><img width=404 height=52 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image005.png\"></p><p><b>We know that:</b> (a  -  b) (a<sup>2</sup> + b<sup>2</sup> + ab) = a<sup>3</sup>  -  b<sup>3</sup></p><p><img width=217 height=44 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image006.png\"></p><p><img width=24 height=16 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image007.png\"></p>", "solution_hi": "<p><img width=289 height=41 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image002.png\"></p><p><img width=316 height=41 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image003.png\"></p><p><img width=392 height=44 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image004.png\"></p><p><img width=404 height=52 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image005.png\"></p><p><b>We know that:</b> (a  -  b) (a<sup>2</sup> + b<sup>2</sup> + ab) = a<sup>3</sup>  -  b<sup>3</sup></p><p><img width=217 height=44 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image006.png\"></p><p><img width=24 height=16 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p22503/image007.png\"></p>"}, {"q_en": "<p><div>&nbsp;Find the value of: (sec &theta; + cosec &theta; -&nbsp;<div style=\"display: inline-block;position: relative;vertical-align: middle;\"><span style=\"text-align:center;display: block; padding: 0;\">1</span><span style=\"display: block; padding: 0;position: absolute; top: 0em; display: none;letter-spacing: -0.1em;\">_________</span><span style=\"display: block; padding: 0;border-top: thin solid black; text-align:center\">sin &theta; cos &theta;</span></div>&nbsp;) (1 + sin &theta; + cos &theta;)&nbsp;</div></p><p></p>", "q_hi": "<p>(sec &#952; + cosec &#952; -1/sin &#952; cos &#952; ) (1 + sin &#952; + cos &#952;) &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2352;&#2375;&#2306;?</p>", "options_en": ["2", "-1", "-2", "1"], "options_hi": ["2", "-1", "-2", "1"], "answer": 0, "solution_en": "<p><img width=316 height=316 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p11734/image015.png\"></p>", "solution_hi": "<p><img width=316 height=316 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p11734/image015.png\"></p>"}, {"q_en": "<p>If 6tanA  -  2tan<sup>3</sup>A = 2&radic;3 - 6&radic;3tan<sup>2</sup>A, then find the value of tan 3A.</p>", "q_hi": "<p>&#2351;&#2342;&#2367; 6tanA - 2tan<sup>3</sup>A = 2&radic;3 - 6&radic;3tan<sup>2</sup>A &#2361;&#2376;, &#2340;&#2379; tan 3A &#2325;&#2366; &#2350;&#2366;&#2344; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p>", "options_en": ["&radic;3", "1/&radic;3", "1", "0"], "options_hi": ["&radic;3", "1/&radic;3", "1", "0"], "answer": 0, "solution_en": "<p>Given,</p><p>6tanA  -  2tan<sup>3</sup>A = 2&radic;3 - 6&radic;3tan<sup>2</sup>A</p><p>2(3tanA  -  tan<sup>3</sup>A) = 2&radic;3 (1  -  3tan<sup>2</sup>A)</p><p>(3tanA  -  tan<sup>3</sup>A)/ (1  -  3tan<sup>2</sup>A) = &radic;3</p><p>tan3A = &radic;3</p>", "solution_hi": "<p>Given,</p><p>6tanA  -  2tan<sup>3</sup>A = 2&radic;3 - 6&radic;3tan<sup>2</sup>A</p><p>2(3tanA  -  tan<sup>3</sup>A) = 2&radic;3 (1  -  3tan<sup>2</sup>A)</p><p>(3tanA  -  tan<sup>3</sup>A)/ (1  -  3tan<sup>2</sup>A) = &radic;3</p><p>tan3A = &radic;3</p>"}]}